#!/bin/sh

ip_address=$(hostname -i)

# Enable distributed mode
export RELEASE_DISTRIBUTION=name

# Tagging the node basename with this task's own image digest keeps nodes from different deploys
# from clustering with each other (DNSCluster only connects to peers sharing its own basename),
# so a rolling deploy never mixes old/new versions in the same distributed Erlang cluster. The
# ECS Task Metadata endpoint reports the digest of the image this specific container is running.
if [ -n "$ECS_CONTAINER_METADATA_URI_V4" ]; then
  image_id="$(wget -qO- "$ECS_CONTAINER_METADATA_URI_V4" | jq -r '.ImageID')"
  image_tag="$(echo "$image_id" | sed 's/^sha256://' | cut -c1-12)"
fi
export RELEASE_NODE="screens-${image_tag:-unknown}@$ip_address"

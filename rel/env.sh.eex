#!/bin/sh

ip_address=$(hostname -i)

# Enable distributed mode
export RELEASE_DISTRIBUTION=name

# Tagging the node basename with the deploy's image tag keeps nodes from different deploys from
# clustering with each other (DNSCluster only connects to peers sharing its own basename), so a
# rolling deploy never mixes old/new versions in the same distributed Erlang cluster.
export RELEASE_NODE="screens-${IMAGE_TAG:-unknown}@$ip_address"
